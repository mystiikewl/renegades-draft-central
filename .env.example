# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ESPN private league (league 201) — cookies from a logged-in espn.com session.
# Rotates periodically; refresh when you get a 401 from the ESPN API.
ESPN_S2=your_espn_s2_cookie
ESPN_SWID=your_swid_cookie

# Supabase Management API token (used by scripts/import-league.mjs write path)
SUPABASE_ACCESS_TOKEN=your_supabase_access_token